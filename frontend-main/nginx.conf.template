# Rendered by the nginx-unprivileged image's entrypoint
# (`envsubst < template > /etc/nginx/conf.d/default.conf`).
# Only ${UPSTREAM_GATEWAY} is substituted (see NGINX_ENVSUBST_FILTER in
# the Dockerfile); all other $variables are nginx runtime vars.

server {
    listen       8080;
    server_name  _;

    # SPA: serve hashed assets with long cache; never cache index.html.
    root   /usr/share/nginx/html;
    index  index.html;

    # Cheap liveness/readiness target. Doesn't touch the upstream.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Long cache for hashed assets emitted by Vite (assets/<name>-<hash>.js).
    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Same-origin proxy to the in-cluster gateway. Strips the /api prefix
    # before forwarding so the gateway sees the same paths it gets in
    # local dev.
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        # Allow streaming endpoints (chat SSE, BFF event-source) to push
        # bytes through without buffering or short timeouts.
        proxy_buffering    off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${UPSTREAM_GATEWAY};
    }

    # SPA fallback — every unknown path serves index.html so TanStack
    # Router can hydrate the route on the client. Must come last.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, must-revalidate";
        expires off;
    }
}
