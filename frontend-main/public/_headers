# Cloudflare Pages headers (mirrors nginx.conf.template caching rules).
# Default: never cache, so index.html (served for every SPA route) stays fresh.
/*
  Cache-Control: no-store, must-revalidate

# Hashed Vite assets: long cache.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  ! Cache-Control
  Cache-Control: no-cache
