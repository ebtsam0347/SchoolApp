{
  "name": "fshrms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:api:fetch": "node scripts/fetch-api-specs.mjs",
    "gen:api": "node scripts/gen-api-types.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test:worker": "vitest run"
  },
  "dependencies": {
    "@casl/ability": "^6.8.1",
    "@casl/react": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.168.25",
    "antd": "^6.3.7",
    "dayjs": "^1.11.20",
    "lucide-react": "^0.460.0",
    "react": "^19.2.0",
    "react-d3-tree": "^3.6.6",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@tanstack/react-query-devtools": "^5.100.6",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.28",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wrangler": "^4.151.0"
  }
}
