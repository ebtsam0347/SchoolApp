# Loaded by `vite build` (Vite picks .env.production over .env when MODE=production).
# Frontend calls fetch('/api/auth/login', ...) which nginx in the deployed pod
# proxies to the in-cluster gateway. Keeps the bundle env-agnostic so the
# same image can be promoted UAT → Prod.
VITE_API_BASE=/api
VITE_ENV=prod
