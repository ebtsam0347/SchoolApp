// Cloudflare Workers config: the SPA is served as static assets from dist/,
// and worker/index.ts handles /api/*, /forms/*, /robots.txt and /sitemap.xml.
// Deploy with `npm run deploy`, or connect the repo in the Cloudflare
// dashboard (Workers Builds) with root directory = frontend-main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolapp",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",

  // Runs before every `wrangler deploy` / `wrangler dev`, so dist/ is always
  // built from source even if the dashboard has no build command set.
  "build": { "command": "npm run build" },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (client-side routes like /home, /login) get index.html.
    "not_found_handling": "single-page-application",
    // These paths go to the Worker instead of the SPA fallback.
    "run_worker_first": ["/api/*", "/forms/*", "/robots.txt", "/sitemap.xml"]
  },

  // Public URL of the backend gateway (no trailing slash). worker/api-proxy.ts
  // proxies /api/* here, mirroring nginx.conf.template.
  // Override per environment in the dashboard: Settings -> Variables and Secrets.
  "vars": {
    "UPSTREAM_GATEWAY": "https://api.example.com"
  }
}
