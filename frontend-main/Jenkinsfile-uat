// web-uat pipeline. Triggered by `main` push (multibranch later) or manual.
// Stages: docker build (multi-stage: vite build inside the image) →
// push to local registry → kustomize edit set image → kubectl apply →
// wait for rollout. Image tag = git short SHA, never `latest`.
//
// No Maven step — the npm install + vite build happen inside the
// Dockerfile's build stage so the host Jenkins agent doesn't need Node.

pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
  }

  environment {
    SERVICE   = 'web'
    REGISTRY  = '10.10.100.50:5001'
    NAMESPACE = 'uat'
  }

  stages {
    stage('checkout') {
      steps {
        checkout scm
        script {
          env.GIT_SHORT_SHA = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
          env.IMAGE = "${REGISTRY}/${SERVICE}:${GIT_SHORT_SHA}"
          echo "Building ${IMAGE}"
        }
      }
    }

    stage('docker build + push') {
      steps {
        // Single-line Dockerfile lives at the repo root. Build context is
        // the whole repo so the multi-stage build can `npm ci` + `vite
        // build` against the source tree.
        sh '''
          docker build -t ${IMAGE} .
          docker push ${IMAGE}
        '''
      }
    }

    stage('kustomize set image + apply') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig-uat', variable: 'KUBECONFIG')]) {
          sh '''
            echo "KUBECONFIG=$KUBECONFIG"
            kubectl --kubeconfig="$KUBECONFIG" config view --minify --raw=false -o jsonpath='{.clusters[0].cluster.server}' || true
            echo
            kubectl --kubeconfig="$KUBECONFIG" -n ${NAMESPACE} get ns ${NAMESPACE}
          '''
          dir("k8s/overlays/uat") {
            // Direct sed of the GIT_SHA_PLACEHOLDER baked into the overlay's
            // kustomization.yaml. `kustomize edit set image` mishandles
            // multi-colon registry URLs (host:port/name:tag).
            sh '''
              sed -i "s|GIT_SHA_PLACEHOLDER|${GIT_SHORT_SHA}|" kustomization.yaml
              echo "--- rendered image ---"
              kustomize build . | grep -E '^[[:space:]]+image:' | head -3
              kustomize build . | kubectl --kubeconfig="$KUBECONFIG" apply -f -
            '''
          }
          sh '''
            kubectl --kubeconfig="$KUBECONFIG" -n ${NAMESPACE} rollout status deploy/${SERVICE} --timeout=300s
            kubectl --kubeconfig="$KUBECONFIG" -n ${NAMESPACE} get pods -l app=${SERVICE} -o wide
          '''
        }
      }
    }
  }

  post {
    success {
      echo "web ${GIT_SHORT_SHA} deployed to ${NAMESPACE}"
    }
    failure {
      withCredentials([file(credentialsId: 'kubeconfig-uat', variable: 'KUBECONFIG')]) {
        sh 'kubectl --kubeconfig="$KUBECONFIG" -n ${NAMESPACE} describe deploy/${SERVICE} || true'
        sh 'kubectl --kubeconfig="$KUBECONFIG" -n ${NAMESPACE} logs -l app=${SERVICE} --tail=200 || true'
      }
    }
  }
}
