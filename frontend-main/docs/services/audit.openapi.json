              "INSERTED",
              "DUPLICATE",
              "STILL_FAILING"
            ],
            "example": "INSERTED"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "If STILL_FAILING, the new reason ingest returned. Else null.",
            "enum": [
              "MALFORMED_JSON",
              "MISSING_EVENT_ID",
              "OVERSIZED_EVENT_ID",
              "MISSING_REQUIRED_PAYLOAD",
              "UNPARSEABLE_OCCURRED_AT"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "If STILL_FAILING, free-form detail. Else null."
          }
        }
