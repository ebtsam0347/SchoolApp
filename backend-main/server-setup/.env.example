# Template for server-setup/.env. Copy to .env ON THE TARGET HOST and fill in.
# .env is gitignored — never commit it.
#
# One environment per host. ENV_NAME picks the Postgres role/database, the k3s
# namespace, and which Jenkins jobs get seeded. HOST_IP is this machine's LAN
# address — it becomes Kafka's advertised EXTERNAL listener, the registry host,
# and DB_HOST/REDIS_HOST for pods.
#
#   VM1  ENV_NAME=uat   HOST_IP=10.10.100.50
#   VM2  ENV_NAME=prod  HOST_IP=10.10.100.51
#
# Generate strong values:  openssl rand -base64 24
# Quote any value containing $ or # with single quotes.

ENV_NAME=uat
HOST_IP=10.10.100.50

# Postgres role password (Phase 2) — role and DB are both named $ENV_NAME
PG_PASSWORD=CHANGE_ME

# Redis (Phase 3) — one instance per host on :6379
REDIS_PASSWORD=CHANGE_ME

# MinIO (Phase 3) — root credentials. Buckets are created by the services
# themselves via hrms.storage.ensure-buckets.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# pgAdmin (Phase 3) — local admin UI on :8091
PGADMIN_EMAIL=admin@fshrms.local
PGADMIN_PASSWORD=CHANGE_ME

# Kafka (Phase 3) — 22-char base64 UUID, auto-generated by
# 05-infrastructure-up.sh on first run. Unique per host; do NOT copy between VMs.
KAFKA_CLUSTER_ID=CHANGE_ME

# Grafana admin (Phase 4)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Jenkins admin (Phase 6)
JENKINS_ADMIN_PASSWORD=CHANGE_ME

# Git remotes Jenkins clones from (Phase 6). SSH form — the deploy key at
# /etc/jenkins/credentials/github_id_ed25519 must be authorised on both repos.
# See "Linking a host to GitHub" in README.md.
GIT_REPO_URL=git@github.com:fs-hrms/backend.git
GIT_WEB_REPO_URL=git@github.com:fs-hrms/frontend.git

# --- Public domain + TLS (prod only) ----------------------------------------
# HOST_SUFFIX is the public suffix the app is served on. Defaults per ENV_NAME:
# hrms.forward.pk on prod, <env>.hrms.local elsewhere. Set it to override.
#HOST_SUFFIX=hrms.forward.pk
#
# The observability UIs are LAN-only and always use <env>.hrms.local; override
# with INTERNAL_SUFFIX if that ever collides.
#INTERNAL_SUFFIX=prod.hrms.local
#
# ACME account email — Let's Encrypt sends expiry warnings here, so it must be
# a real mailbox someone reads.
ACME_EMAIL=admin@forward.pk
# letsencrypt-staging until a cert reaches Ready, then letsencrypt-prod.
# Production rate-limits failed validations hard; do not start here.
ACME_ISSUER=letsencrypt-staging
