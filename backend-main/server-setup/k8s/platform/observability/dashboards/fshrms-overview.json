{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "All FSHRMS services at a glance: up/down, RED, replicas, restarts.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Service detail", "url": "/d/fshrms-service-detail", "type": "link", "tags": [], "icon": "dashboard", "tooltip": "Drill into one service" },
    { "title": "Logs", "url": "/d/fshrms-logs", "type": "link", "tags": [], "icon": "doc", "tooltip": "Live log explorer" }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Services UP",
      "id": 1,
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(up{namespace=\"$ns\", service=~\"$svc_re\"})", "legendFormat": "up" },
        { "refId": "B", "expr": "count(up{namespace=\"$ns\", service=~\"$svc_re\"})", "legendFormat": "total" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "green", "value": 9 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Total req/s",
      "id": 2,
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Cluster error rate",
      "id": 3,
      "gridPos": { "h": 4, "w": 7, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval])), 0.001)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Cluster p95 latency",
      "id": 4,
      "gridPos": { "h": 4, "w": 7, "x": 17, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval])))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "type": "table",
      "title": "Services",
      "id": 5,
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "UP",       "expr": "max by (service) (up{namespace=\"$ns\", service=~\"$svc_re\"})", "instant": true, "format": "table" },
        { "refId": "REPLICAS", "expr": "count by (service) (up{namespace=\"$ns\", service=~\"$svc_re\"} == 1)", "instant": true, "format": "table" },
        { "refId": "RPS",      "expr": "sum by (service) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval]))", "instant": true, "format": "table" },
        { "refId": "ERR",      "expr": "sum by (service) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval])), 0.001)", "instant": true, "format": "table" },
        { "refId": "P95",      "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval])))", "instant": true, "format": "table" },
        { "refId": "HEAPPCT",  "expr": "max by (service) (sum by (service, instance) (jvm_memory_used_bytes{namespace=\"$ns\", service=~\"$svc_re\", area=\"heap\"}) / sum by (service, instance) (jvm_memory_max_bytes{namespace=\"$ns\", service=~\"$svc_re\", area=\"heap\"} > 0))", "instant": true, "format": "table" },
        { "refId": "CPU",      "expr": "max by (service) (process_cpu_usage{namespace=\"$ns\", service=~\"$svc_re\"})", "instant": true, "format": "table" },
        { "refId": "RESTARTS", "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"$ns\", container=~\"$svc_re\"}[$__range]))", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": "^container$", "renamePattern": "service" }
        },
        { "id": "joinByField", "options": { "byField": "service", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true, "Time 6": true, "Time 7": true, "Time 8": true },
            "indexByName": { "service": 0, "Value #UP": 1, "Value #REPLICAS": 2, "Value #RPS": 3, "Value #ERR": 4, "Value #P95": 5, "Value #HEAPPCT": 6, "Value #CPU": 7, "Value #RESTARTS": 8 },
            "renameByName": {
              "service": "Service",
              "Value #UP": "UP",
              "Value #REPLICAS": "Replicas",
              "Value #RPS": "Req/s",
              "Value #ERR": "Err %",
              "Value #P95": "p95 (s)",
              "Value #HEAPPCT": "Heap %",
              "Value #CPU": "CPU",
              "Value #RESTARTS": "Restarts"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "UP" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } } ] }
            ]
          },
          { "matcher": { "id": "byName", "options": "Req/s" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 1 } ] },
          {
            "matcher": { "id": "byName", "options": "Err %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95 (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Heap %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "CPU" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 2 } ] },
          {
            "matcher": { "id": "byName", "options": "Restarts" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [
              {
                "id": "links",
                "value": [
                  { "title": "Service detail", "url": "/d/fshrms-service-detail?var-ns=${ns}&var-service=${__value.raw}" }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate by service",
      "id": 6,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval]))", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "5xx rate by service",
      "id": 7,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=~\"$svc_re\", status=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "id": 8,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=~\"$svc_re\"}[$__rate_interval])))", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Heap used % of max by service",
      "id": 9,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (service) (sum by (service, instance) (jvm_memory_used_bytes{namespace=\"$ns\", service=~\"$svc_re\", area=\"heap\"}) / sum by (service, instance) (jvm_memory_max_bytes{namespace=\"$ns\", service=~\"$svc_re\", area=\"heap\"} > 0))", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["fshrms"],
  "templating": {
    "list": [
      {
        "name": "ns",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=~\"auth|audit|employee|attendance|payroll|notification|chat|gateway|bff\"}, namespace)", "refId": "ns" },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "current": { "selected": false, "text": "uat", "value": "uat" },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "svc_re",
        "label": "Services",
        "type": "constant",
        "query": "auth|audit|employee|attendance|payroll|notification|chat|gateway|bff",
        "current": { "selected": false, "text": "auth|audit|employee|attendance|payroll|notification|chat|gateway|bff", "value": "auth|audit|employee|attendance|payroll|notification|chat|gateway|bff" },
        "hide": 2
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Karachi",
  "title": "FSHRMS — Overview",
  "uid": "fshrms-overview",
  "version": 1,
  "weekStart": ""
}
