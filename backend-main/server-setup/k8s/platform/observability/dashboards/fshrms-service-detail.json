{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Drill into one FSHRMS service: HTTP, JVM, DB pool, Kafka, logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Overview", "url": "/d/fshrms-overview", "type": "link", "icon": "dashboard" },
    { "title": "Logs", "url": "/d/fshrms-logs?var-ns=${ns}&var-service=${service}", "type": "link", "icon": "doc" }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "id": 100,
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(up{namespace=\"$ns\", service=\"$service\"})" },
        { "refId": "B", "expr": "count(up{namespace=\"$ns\", service=\"$service\"})" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Req/s",
      "id": 101,
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "area", "colorMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Error %",
      "id": 102,
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"$ns\", service=\"$service\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"$ns\", service=\"$service\"}[$__rate_interval])), 0.001)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "area", "colorMode": "background", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "p95",
      "id": 103,
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=\"$service\"}[$__rate_interval])))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 } ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "area", "colorMode": "background", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "p99",
      "id": 104,
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=\"$service\"}[$__rate_interval])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "area", "colorMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Heap used / max",
      "id": 105,
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(sum by (instance) (jvm_memory_used_bytes{namespace=\"$ns\", service=\"$service\", area=\"heap\"}) / sum by (instance) (jvm_memory_max_bytes{namespace=\"$ns\", service=\"$service\", area=\"heap\"} > 0))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 } ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "area", "colorMode": "background", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "CPU",
      "id": 106,
      "gridPos": { "h": 3, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(process_cpu_usage{namespace=\"$ns\", service=\"$service\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "area", "colorMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Restarts",
      "id": 107,
      "gridPos": { "h": 3, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$ns\", container=\"$service\"}[$__range]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "graphMode": "none", "colorMode": "background", "textMode": "value" }
    },
    {
      "type": "row",
      "id": 200,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "title": "HTTP",
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Slowest endpoints — p95 (top 8)",
      "id": 201,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "5xx by URI (top 8)",
      "id": 202,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=\"$service\", status=~\"5..\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Status code breakdown",
      "id": 203,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^2.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byRegexp", "options": "^3.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byRegexp", "options": "^4.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byRegexp", "options": "^5.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "id": 204,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "P50", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=\"$service\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "P95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=\"$service\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "P99", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$ns\", service=\"$service\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "id": 300,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "title": "JVM",
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap (used / committed / max)",
      "id": 301,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "U", "expr": "sum(jvm_memory_used_bytes{namespace=\"$ns\", service=\"$service\", area=\"heap\"})", "legendFormat": "used" },
        { "refId": "C", "expr": "sum(jvm_memory_committed_bytes{namespace=\"$ns\", service=\"$service\", area=\"heap\"})", "legendFormat": "committed" },
        { "refId": "M", "expr": "sum(jvm_memory_max_bytes{namespace=\"$ns\", service=\"$service\", area=\"heap\"} > 0)", "legendFormat": "max" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 5] } }, { "id": "custom.fillOpacity", "value": 0 } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "GC pause time (rate)",
      "id": 302,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{action}} / {{cause}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 4, "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Threads (live / daemon / peak)",
      "id": 303,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "L", "expr": "max(jvm_threads_live_threads{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "live" },
        { "refId": "D", "expr": "max(jvm_threads_daemon_threads{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "daemon" },
        { "refId": "P", "expr": "max(jvm_threads_peak_threads{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "peak" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "CPU (process / system)",
      "id": 304,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "P", "expr": "max(process_cpu_usage{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "process" },
        { "refId": "S", "expr": "max(system_cpu_usage{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "system" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "id": 400,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "title": "Database (HikariCP)",
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pool: active / idle / pending / max",
      "id": 401,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "ACT", "expr": "sum(hikaricp_connections_active{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "active" },
        { "refId": "IDL", "expr": "sum(hikaricp_connections_idle{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "idle" },
        { "refId": "PEN", "expr": "sum(hikaricp_connections_pending{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "pending" },
        { "refId": "MAX", "expr": "max(hikaricp_connections_max{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "max" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 5] } }, { "id": "custom.fillOpacity", "value": 0 } ] },
          { "matcher": { "id": "byName", "options": "pending" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Acquire / usage time + timeouts",
      "id": 402,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "ACQ", "expr": "max(hikaricp_connections_acquire_seconds_max{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "acquire (max)" },
        { "refId": "USE", "expr": "max(hikaricp_connections_usage_seconds_max{namespace=\"$ns\", service=\"$service\"})", "legendFormat": "usage (max)" },
        { "refId": "TOUT", "expr": "sum(rate(hikaricp_connections_timeout_total{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))", "legendFormat": "timeouts /s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "timeouts /s" }, "properties": [ { "id": "unit", "value": "ops" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.axisPlacement", "value": "right" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "id": 500,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "title": "Kafka",
      "collapsed": false,
      "panels": [
        {
          "type": "timeseries",
          "title": "Consume rate by listener",
          "id": 501,
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 45 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "sum by (name) (rate(spring_kafka_listener_seconds_count{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{name}}" }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }, "tooltip": { "mode": "multi" } }
        },
        {
          "type": "timeseries",
          "title": "Listener failures (result=failure)",
          "id": 502,
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 45 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "sum by (name, exception) (rate(spring_kafka_listener_seconds_count{namespace=\"$ns\", service=\"$service\", result=\"failure\"}[$__rate_interval]))", "legendFormat": "{{name}} {{exception}}" }
          ],
          "fieldConfig": {
            "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0 } },
            "overrides": []
          },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "type": "timeseries",
          "title": "Outbox publish rate (kafkaTemplate)",
          "id": 503,
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 45 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            { "refId": "A", "expr": "sum by (result) (rate(spring_kafka_template_seconds_count{namespace=\"$ns\", service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{result}}" }
          ],
          "fieldConfig": {
            "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
            "overrides": [
              { "matcher": { "id": "byName", "options": "failure" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
              { "matcher": { "id": "byName", "options": "success" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
            ]
          },
          "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
        }
      ]
    },
    {
      "type": "row",
      "id": 600,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "title": "Logs",
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Recent ERROR/WARN (click traceId → Zipkin)",
      "id": 601,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 54 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"$ns\", app=\"$service\"} | json | level=~\"WARN|ERROR\" | line_format `[{{.level}}] {{.logger_name}} - {{.message}}{{if .stack_trace}}\\n{{.stack_trace}}{{end}}`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
