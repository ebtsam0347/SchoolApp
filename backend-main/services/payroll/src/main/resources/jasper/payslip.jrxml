<?xml version="1.0" encoding="UTF-8"?>
<!--
  Payslip template. Driven by header parameters (see PayslipPdfService.fill)
  + a JRMapCollectionDataSource zipping the earnings/deductions line lists
  into one row-per-index list (earningName/earningCode/earningAmountText,
  deductionName/deductionCode/deductionAmountText — one side left blank once
  its list runs out). All money/quantity values arrive pre-formatted so the
  template does not depend on the JVM locale.

  Layout mirrors the run-detail screen: letterhead (logo, company, period),
  employee card, attendance, leaves, earnings | deductions side by side,
  totals, net payable callout. Brand color #9A2D2A; every color choice is
  backed by weight or a border so it survives black & white printing.
  `logo` is optional — without it a monogram is drawn instead.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payslip" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="9c5c3d36-1234-4abc-8000-000000000001">

    <style name="label" forecolor="#8A8079" fontName="SansSerif" fontSize="6.5" isBold="true"/>
    <style name="value" forecolor="#1A1714" fontName="SansSerif" fontSize="9"/>
    <style name="section" forecolor="#9A2D2A" fontName="SansSerif" fontSize="7.5" isBold="true"/>
    <style name="row.zebra" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
            <style backcolor="#FAF7F2"/>
        </conditionalStyle>
    </style>

    <parameter name="companyName"    class="java.lang.String"/>
    <parameter name="companyAddress" class="java.lang.String"/>
    <parameter name="logo"           class="java.awt.Image"/>
    <parameter name="monthLabel"     class="java.lang.String"/>
    <parameter name="fiscalYear"     class="java.lang.String"/>
    <parameter name="heldBanner"     class="java.lang.String"/>

    <parameter name="employeeCode"   class="java.lang.String"/>
    <parameter name="employeeName"   class="java.lang.String"/>
    <parameter name="fatherName"     class="java.lang.String"/>
    <parameter name="designation"    class="java.lang.String"/>
    <parameter name="department"     class="java.lang.String"/>
    <parameter name="grade"          class="java.lang.String"/>
    <parameter name="dateOfJoining"  class="java.lang.String"/>
    <parameter name="bankName"       class="java.lang.String"/>
    <parameter name="bankAccount"    class="java.lang.String"/>
    <parameter name="advanceBalanceText" class="java.lang.String"/>

    <parameter name="workingDaysText"  class="java.lang.String"/>
    <parameter name="daysWorkedText"   class="java.lang.String"/>
    <parameter name="presentDaysText"  class="java.lang.String"/>
    <parameter name="absentDaysText"   class="java.lang.String"/>
    <parameter name="lopDaysText"      class="java.lang.String"/>
    <parameter name="paidLeaveDaysText"   class="java.lang.String"/>
    <parameter name="unpaidLeaveDaysText" class="java.lang.String"/>
    <parameter name="holidaysText"     class="java.lang.String"/>
    <parameter name="weeklyOffText"    class="java.lang.String"/>
    <parameter name="overtimeHoursText" class="java.lang.String"/>

    <parameter name="casualLeavesMonthText"  class="java.lang.String"/>
    <parameter name="totalCasualLeavesText"  class="java.lang.String"/>
    <parameter name="medicalLeavesMonthText" class="java.lang.String"/>
    <parameter name="totalMedicalLeavesText" class="java.lang.String"/>
    <parameter name="annualAvailedText"      class="java.lang.String"/>
    <parameter name="annualBalanceText"      class="java.lang.String"/>

    <parameter name="grossSalaryText"    class="java.lang.String"/>
    <parameter name="totalDeductionText" class="java.lang.String"/>
    <parameter name="netSalaryText"      class="java.lang.String"/>
    <parameter name="netSalaryWords"     class="java.lang.String"/>
    <parameter name="generatedAt"        class="java.lang.String"/>
    <parameter name="generatedBy"        class="java.lang.String"/>

    <field name="earningName"         class="java.lang.String"/>
    <field name="earningCode"         class="java.lang.String"/>
    <field name="earningAmountText"   class="java.lang.String"/>
    <field name="deductionName"       class="java.lang.String"/>
    <field name="deductionCode"       class="java.lang.String"/>
    <field name="deductionAmountText" class="java.lang.String"/>

    <title>
        <band height="360" splitType="Stretch">
            <!-- ===== Letterhead ===== -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="4" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="14" width="70" height="54">
                    <printWhenExpression><![CDATA[$P{logo} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logo}]]></imageExpression>
            </image>
            <ellipse>
                <reportElement x="4" y="17" width="48" height="48" backcolor="#9A2D2A" mode="Opaque">
                    <printWhenExpression><![CDATA[$P{logo} == null]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </ellipse>
            <staticText>
                <reportElement x="4" y="17" width="48" height="48" forecolor="#FFFFFF">
                    <printWhenExpression><![CDATA[$P{logo} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true"/></textElement>
                <text><![CDATA[SOI]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="18" width="270" height="22" forecolor="#1A1714"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="80" y="40" width="270" height="12" forecolor="#6B625A"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{companyAddress}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="80" y="52" width="270" height="12" forecolor="#6B625A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <text><![CDATA[Human Resources & Payroll]]></text>
            </staticText>

            <staticText>
                <reportElement x="305" y="10" width="250" height="30" forecolor="#9A2D2A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="20" isBold="true"/></textElement>
                <text><![CDATA[PAYSLIP]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="40" width="200" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{monthLabel}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="355" y="54" width="200" height="12" forecolor="#6B625A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7.5"/></textElement>
                <textFieldExpression><![CDATA["Fiscal Year " + $P{fiscalYear}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="76" width="555" height="1" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.25"/></graphicElement>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="82" width="555" height="18" isRemoveLineWhenBlank="true" forecolor="#991B1B" backcolor="#FDECEC" mode="Opaque">
                    <printWhenExpression><![CDATA[$P{heldBanner} != null && !$P{heldBanner}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.75" lineColor="#991B1B"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{heldBanner}]]></textFieldExpression>
            </textField>

            <!-- ===== Employee card ===== -->
            <rectangle radius="4">
                <reportElement positionType="Float" x="0" y="106" width="555" height="112" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E5DDD0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement positionType="Float" x="0" y="112" width="3" height="32" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement positionType="Float" x="12" y="112" width="400" height="18" forecolor="#1A1714"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{employeeName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement positionType="Float" x="12" y="130" width="400" height="12" forecolor="#6B625A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{designation} + "  ·  " + $P{employeeCode}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="12" y="150" width="531" height="1" forecolor="#E5DDD0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>

            <staticText><reportElement positionType="Float" style="label" x="12"  y="157" width="130" height="10"/><text><![CDATA[EMPLOYEE CODE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="12"  y="167" width="130" height="13"/><textFieldExpression><![CDATA[$P{employeeCode}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="146" y="157" width="130" height="10"/><text><![CDATA[FATHER NAME]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="146" y="167" width="130" height="13"/><textFieldExpression><![CDATA[$P{fatherName}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="280" y="157" width="130" height="10"/><text><![CDATA[DEPARTMENT]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="280" y="167" width="130" height="13"/><textFieldExpression><![CDATA[$P{department}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="414" y="157" width="130" height="10"/><text><![CDATA[GRADE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="414" y="167" width="130" height="13"/><textFieldExpression><![CDATA[$P{grade}]]></textFieldExpression></textField>

            <staticText><reportElement positionType="Float" style="label" x="12"  y="187" width="130" height="10"/><text><![CDATA[DATE OF JOINING]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="12"  y="197" width="130" height="13"/><textFieldExpression><![CDATA[$P{dateOfJoining}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="146" y="187" width="130" height="10"/><text><![CDATA[BANK]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="146" y="197" width="130" height="13"/><textFieldExpression><![CDATA[$P{bankName}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="280" y="187" width="130" height="10"/><text><![CDATA[ACCOUNT NO.]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="280" y="197" width="130" height="13"/><textFieldExpression><![CDATA[$P{bankAccount}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="414" y="187" width="130" height="10"/><text><![CDATA[P. ADVANCE BALANCE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="414" y="197" width="130" height="13"/><textFieldExpression><![CDATA[$P{advanceBalanceText}]]></textFieldExpression></textField>

            <!-- ===== Attendance ===== -->
            <staticText><reportElement positionType="Float" style="section" x="0" y="228" width="200" height="12"/><text><![CDATA[ATTENDANCE]]></text></staticText>
            <rectangle radius="4">
                <reportElement positionType="Float" x="0" y="242" width="555" height="60" backcolor="#FAF7F2" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E5DDD0"/></graphicElement>
            </rectangle>
            <staticText><reportElement positionType="Float" style="label" x="12"  y="248" width="104" height="10"/><text><![CDATA[WORKING DAYS]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="12"  y="258" width="104" height="13"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$P{workingDaysText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="118" y="248" width="104" height="10"/><text><![CDATA[DAYS WORKED (PAID)]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="118" y="258" width="104" height="13"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$P{daysWorkedText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="224" y="248" width="104" height="10"/><text><![CDATA[PRESENT DAYS]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="224" y="258" width="104" height="13"/><textFieldExpression><![CDATA[$P{presentDaysText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="330" y="248" width="104" height="10"/><text><![CDATA[ABSENT DAYS]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="330" y="258" width="104" height="13"/><textFieldExpression><![CDATA[$P{absentDaysText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="436" y="248" width="104" height="10"/><text><![CDATA[LOP DAYS]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="436" y="258" width="104" height="13"/><textFieldExpression><![CDATA[$P{lopDaysText}]]></textFieldExpression></textField>

            <staticText><reportElement positionType="Float" style="label" x="12"  y="276" width="104" height="10"/><text><![CDATA[PAID LEAVE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="12"  y="286" width="104" height="13"/><textFieldExpression><![CDATA[$P{paidLeaveDaysText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="118" y="276" width="104" height="10"/><text><![CDATA[UNPAID LEAVE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="118" y="286" width="104" height="13"/><textFieldExpression><![CDATA[$P{unpaidLeaveDaysText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="224" y="276" width="104" height="10"/><text><![CDATA[HOLIDAYS]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="224" y="286" width="104" height="13"/><textFieldExpression><![CDATA[$P{holidaysText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="330" y="276" width="104" height="10"/><text><![CDATA[WEEKLY OFF]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="330" y="286" width="104" height="13"/><textFieldExpression><![CDATA[$P{weeklyOffText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="436" y="276" width="104" height="10"/><text><![CDATA[OVERTIME HOURS]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="436" y="286" width="104" height="13"/><textFieldExpression><![CDATA[$P{overtimeHoursText}]]></textFieldExpression></textField>

            <!-- ===== Leaves ===== -->
            <staticText><reportElement positionType="Float" style="section" x="0" y="310" width="200" height="12"/><text><![CDATA[LEAVES]]></text></staticText>
            <rectangle radius="4">
                <reportElement positionType="Float" x="0" y="324" width="555" height="32" backcolor="#FAF7F2" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#E5DDD0"/></graphicElement>
            </rectangle>
            <staticText><reportElement positionType="Float" style="label" x="12"  y="328" width="88" height="10"/><text><![CDATA[CASUAL · MONTH]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="12"  y="338" width="88" height="13"/><textFieldExpression><![CDATA[$P{casualLeavesMonthText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="100" y="328" width="88" height="10"/><text><![CDATA[CASUAL · CYCLE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="100" y="338" width="88" height="13"/><textFieldExpression><![CDATA[$P{totalCasualLeavesText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="188" y="328" width="88" height="10"/><text><![CDATA[MEDICAL · MONTH]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="188" y="338" width="88" height="13"/><textFieldExpression><![CDATA[$P{medicalLeavesMonthText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="276" y="328" width="88" height="10"/><text><![CDATA[MEDICAL · CYCLE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="276" y="338" width="88" height="13"/><textFieldExpression><![CDATA[$P{totalMedicalLeavesText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="364" y="328" width="88" height="10"/><text><![CDATA[ANNUAL · AVAILED]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="364" y="338" width="88" height="13"/><textFieldExpression><![CDATA[$P{annualAvailedText}]]></textFieldExpression></textField>
            <staticText><reportElement positionType="Float" style="label" x="452" y="328" width="88" height="10"/><text><![CDATA[ANNUAL · BALANCE]]></text></staticText>
            <textField><reportElement positionType="Float" style="value" x="452" y="338" width="88" height="13"/><textFieldExpression><![CDATA[$P{annualBalanceText}]]></textFieldExpression></textField>
        </band>
    </title>

    <columnHeader>
        <band height="26" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="4" width="270" height="22" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="4" width="180" height="22" forecolor="#FFFFFF"/>
                <box leftPadding="10"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true"/></textElement>
                <text><![CDATA[EARNINGS]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="4" width="90" height="22" forecolor="#FFFFFF"/>
                <box rightPadding="10"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[AMOUNT (Rs)]]></text>
            </staticText>
            <rectangle>
                <reportElement x="285" y="4" width="270" height="22" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="285" y="4" width="180" height="22" forecolor="#FFFFFF"/>
                <box leftPadding="10"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true"/></textElement>
                <text><![CDATA[DEDUCTIONS]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="4" width="90" height="22" forecolor="#FFFFFF"/>
                <box rightPadding="10"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isBold="true"/></textElement>
                <text><![CDATA[AMOUNT (Rs)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Prevent">
            <!-- Earnings side -->
            <frame>
                <reportElement style="row.zebra" x="0" y="0" width="270" height="16"/>
                <box><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textField isBlankWhenNull="true">
                    <reportElement x="10" y="0" width="180" height="16" forecolor="#1A1714"/>
                    <textElement verticalAlignment="Middle" markup="styled"><font fontName="SansSerif" size="8"/></textElement>
                    <textFieldExpression><![CDATA[$F{earningName} + ($F{earningCode} == null || $F{earningCode}.isEmpty() ? "" : "  <style forecolor=\"#8A8079\" size=\"5.5\">" + $F{earningCode} + "</style>")]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="190" y="0" width="70" height="16" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                    <textFieldExpression><![CDATA[$F{earningAmountText}]]></textFieldExpression>
                </textField>
            </frame>
            <!-- Deductions side -->
            <frame>
                <reportElement style="row.zebra" x="285" y="0" width="270" height="16"/>
                <box><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textField isBlankWhenNull="true">
                    <reportElement x="10" y="0" width="180" height="16" forecolor="#1A1714"/>
                    <textElement verticalAlignment="Middle" markup="styled"><font fontName="SansSerif" size="8"/></textElement>
                    <textFieldExpression><![CDATA[$F{deductionName} + ($F{deductionCode} == null || $F{deductionCode}.isEmpty() ? "" : "  <style forecolor=\"#8A8079\" size=\"5.5\">" + $F{deductionCode} + "</style>")]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="190" y="0" width="70" height="16" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                    <textFieldExpression><![CDATA[$F{deductionAmountText}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </detail>

    <summary>
        <band height="128" splitType="Prevent">
            <!-- Totals row, one per side -->
            <frame>
                <reportElement x="0" y="0" width="270" height="24" backcolor="#F3ECE1" mode="Opaque"/>
                <box><topPen lineWidth="1.25" lineColor="#9A2D2A"/><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <staticText>
                    <reportElement x="10" y="0" width="150" height="24" forecolor="#1A1714"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Gross Earnings]]></text>
                </staticText>
                <textField>
                    <reportElement x="160" y="0" width="100" height="24" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{grossSalaryText}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement x="285" y="0" width="270" height="24" backcolor="#F3ECE1" mode="Opaque"/>
                <box><topPen lineWidth="1.25" lineColor="#9A2D2A"/><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <staticText>
                    <reportElement x="10" y="0" width="150" height="24" forecolor="#1A1714"/>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <text><![CDATA[Total Deductions]]></text>
                </staticText>
                <textField>
                    <reportElement x="160" y="0" width="100" height="24" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{totalDeductionText}]]></textFieldExpression>
                </textField>
            </frame>


            <!-- Net payable callout -->
            <rectangle radius="4">
                <reportElement x="0" y="30" width="555" height="56" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="38" width="250" height="14" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[NET PAYABLE]]></text>
            </staticText>
            <textField>
                <reportElement x="16" y="54" width="330" height="24" forecolor="#F5E6E5"/>
                <textElement verticalAlignment="Top"><font fontName="SansSerif" size="7.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{netSalaryWords}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="38" width="209" height="40" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="20" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs " + $P{netSalaryText}]]></textFieldExpression>
            </textField>

            <!-- Footer -->
            <line>
                <reportElement x="0" y="98" width="555" height="1" forecolor="#E5DDD0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="102" width="330" height="12" forecolor="#6B625A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <text><![CDATA[This is a system-generated payslip and does not require a signature.]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="330" y="102" width="225" height="24" forecolor="#6B625A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="6.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated by FS-HRMS on " + $P{generatedAt}
                    + ($P{generatedBy} == null || $P{generatedBy}.isEmpty() ? "" : "\nby " + $P{generatedBy})]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
