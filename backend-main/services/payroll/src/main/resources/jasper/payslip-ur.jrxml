    <summary>
        <band height="138" splitType="Prevent">
            <frame>
                <reportElement x="285" y="0" width="270" height="26" backcolor="#F3ECE1" mode="Opaque"/>
                <box><topPen lineWidth="1.25" lineColor="#9A2D2A"/><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <staticText>
                    <reportElement x="110" y="0" width="150" height="26" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="9"/></textElement>
                    <text><![CDATA[کل آمدنی]]></text>
                </staticText>
                <textField>
                    <reportElement x="10" y="0" width="100" height="26" forecolor="#1A1714"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{grossSalaryText}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement x="0" y="0" width="270" height="26" backcolor="#F3ECE1" mode="Opaque"/>
                <box><topPen lineWidth="1.25" lineColor="#9A2D2A"/><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <staticText>
                    <reportElement x="110" y="0" width="150" height="26" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="9"/></textElement>
                    <text><![CDATA[کل کٹوتیاں]]></text>
                </staticText>
                <textField>
                    <reportElement x="10" y="0" width="100" height="26" forecolor="#1A1714"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{totalDeductionText}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Net payable callout: Urdu label right, amount left. -->
            <rectangle radius="4">
                <reportElement x="0" y="32" width="555" height="60" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="300" y="36" width="240" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="10"/></textElement>
                <text><![CDATA[قابل ادائیگی خالص رقم]]></text>
            </staticText>
            <textField>
                <reportElement x="210" y="62" width="330" height="24" forecolor="#F5E6E5"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font fontName="SansSerif" size="7.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{netSalaryWords}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="16" y="40" width="200" height="40" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="20" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs " + $P{netSalaryText}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="92" width="555" height="1" forecolor="#E5DDD0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="94" width="555" height="18" forecolor="#6B625A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="7"/></textElement>
                <text><![CDATA[یہ کمپیوٹر سے تیار کردہ پرچی ہے، اس پر دستخط کی ضرورت نہیں۔]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="112" width="300" height="24" forecolor="#6B625A"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="6.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated by FS-HRMS on " + $P{generatedAt}
                    + ($P{generatedBy} == null || $P{generatedBy}.isEmpty() ? "" : "\nby " + $P{generatedBy})]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
