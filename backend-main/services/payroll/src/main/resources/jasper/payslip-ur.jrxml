            </rectangle>
            <staticText>
                <reportElement x="90" y="4" width="170" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="9"/></textElement>
                <text><![CDATA[کٹوتیاں]]></text>
            </staticText>
            <staticText>
                <reportElement x="10" y="4" width="80" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="7"/></textElement>
                <text><![CDATA[رقم (روپے)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="17" splitType="Prevent">
            <frame>
                <reportElement style="row.zebra" x="285" y="0" width="270" height="17"/>
                <box><leftPen lineWidth="0.5" lineColor="#E5DDD0"/><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/><rightPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textField isBlankWhenNull="true">
                    <reportElement x="90" y="0" width="170" height="17" forecolor="#1A1714"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="6.5"/></textElement>
