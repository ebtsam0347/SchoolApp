                <text><![CDATA[آمدنی]]></text>
            </staticText>
            <staticText>
                <reportElement x="295" y="4" width="80" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Noto Nastaliq Urdu" size="7"/></textElement>
                <text><![CDATA[رقم (روپے)]]></text>
