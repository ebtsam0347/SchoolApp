<?xml version="1.0" encoding="UTF-8"?>
<!--
  EOBI return — monthly listing of enrolled employees and their EOBI
  contribution for a single payroll period. Driven by parameters
  (period, totals) + a JRBeanCollectionDataSource of EobiRow records.
  Used by HR as the source data for the regulator's portal entry; this
  is not a regulator-issued form.

  Statutory-form styling (see masters/statutory-form.jrxml) — only the
  letterhead carries brand color (#9A2D2A rule); the table itself is
  black text on white with solid black grid borders and no zebra, so it
  reads as an official register even photocopied in black & white.
  Parameter/field names are StatutoryReportService's contract — do not
  rename.
-->
<jasperReport whenNoDataType="AllSectionsNoDetail" xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="eobi-return" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="9c5c3d36-1234-4abc-8000-000000000010">

    <parameter name="companyName"  class="java.lang.String"/>
    <parameter name="logoPath"     class="java.lang.String"/>
    <parameter name="period"       class="java.lang.String"/>
    <parameter name="generatedAt"  class="java.lang.String"/>
    <parameter name="generatedBy"  class="java.lang.String"/>
    <parameter name="totalCount"   class="java.lang.Integer"/>
    <parameter name="totalAmount"  class="java.lang.String"/>

    <field name="serial"        class="java.lang.Integer"/>
    <field name="employeeCode"  class="java.lang.String"/>
    <field name="eobiNumber"    class="java.lang.String"/>
    <field name="employeeName"  class="java.lang.String"/>
    <field name="cnic"          class="java.lang.String"/>
    <field name="amountText"    class="java.lang.String"/>

    <title>
        <band height="66" splitType="Stretch">
            <image onErrorType="Blank">
                <reportElement x="0" y="6" width="50" height="34">
                    <printWhenExpression><![CDATA[$P{logoPath} != null && !$P{logoPath}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logoPath}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="50" y="2" width="702" height="20" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["EOBI RETURN — " + $P{period}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="24" width="702" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="46" width="802" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="50" width="802" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated " + $P{generatedAt}
                    + ($P{generatedBy} == null || $P{generatedBy}.isEmpty() ? "" : " by " + $P{generatedBy})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="40" height="20" forecolor="#1A1714"/>
                <box><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[S.No]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="120" height="20" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Employee Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="120" height="20" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[EOBI Number]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="240" height="20" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Employee Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="520" y="0" width="160" height="20" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[CNIC]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="122" height="20" forecolor="#1A1714"/>
                <box rightPadding="6"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Contribution]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="40" height="18" forecolor="#1A1714"/>
                <box><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{serial}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="120" height="18" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{employeeCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="120" height="18" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{eobiNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="0" width="240" height="18" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{employeeName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="520" y="0" width="160" height="18" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cnic}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="680" y="0" width="122" height="18" forecolor="#1A1714"/>
                <box rightPadding="6"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{amountText}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="802" height="1" forecolor="#E5DDD0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="650" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated by FS-HRMS on " + $P{generatedAt}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="650" y="6" width="112" height="14" forecolor="#4A413A"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="762" y="6" width="40" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="22">
            <textField>
                <reportElement x="0" y="0" width="440" height="20" forecolor="#1A1714"/>
                <box leftPadding="6"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{totalCount} + " enrolled employees"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="440" y="0" width="240" height="20" forecolor="#1A1714"/>
                <box rightPadding="8"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTALS]]></text>
            </staticText>
            <textField>
                <reportElement x="680" y="0" width="122" height="20" forecolor="#1A1714"/>
                <box rightPadding="6"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{totalAmount}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
