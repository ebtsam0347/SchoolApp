<?xml version="1.0" encoding="UTF-8"?>
<!--
  MASTER TEMPLATE — Tabular register (category 1).

  Copy this file to start a new register report (pay register, daily/
  monthly attendance, absentee log, OT register, leave balance,
  joiners/leavers, ...). Replace the four demo fields/columns with the
  real ones; keep the band structure and style names as-is so every
  register in the system reads as one family.

  Layout: title band = letterhead (logo left, company + report title
  center, generated/period right, thin accent rule). columnHeader =
  bold black column labels with a bottom accent rule (no fill — prints
  correctly in black & white). detail = zebra-striped rows. summary =
  bold totals row. pageFooter = "Generated by FS-HRMS on {date}" +
  "Page X of Y" (repeats on every page).

  Brand identity is fixed (not the web app's live theme):
    primary/accent  #9A2D2A   header band + top rule + section dividers only
    teal (optional) #0F766E   statutory/info callouts only — not used here
    body text       #1A1714
    label/secondary #4A413A
    zebra stripe    #F8F4ED   alternates with #FFFFFF
    border/rule     #E5DDD0
  Status colors (success #15803D / warning #B45309 / error #991B1B) are
  text-only, never fills, and only where a row has an actual status to
  report.

  Font: SansSerif (JVM logical font — always resolvable without a
  registered font extension; the safe equivalent of "DejaVu Sans" per
  spec since no font extension is configured in this repo). 9-10pt body,
  14-16pt titles.

  Parameters are the only place company name / logo / generation
  date+user are supplied — never hardcode them in a real report.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="master-tabular-register" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="9c5c3d36-1234-4abc-8000-0000000000f1">

    <style name="row.zebra" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
            <style backcolor="#F8F4ED"/>
        </conditionalStyle>
    </style>

    <!-- Standard letterhead/footer parameters — every register report takes these. -->
    <parameter name="companyName"  class="java.lang.String"/>
    <parameter name="logoPath"     class="java.lang.String"/>
    <parameter name="reportTitle"  class="java.lang.String"/>
    <parameter name="periodLabel"  class="java.lang.String"/>
    <parameter name="generatedAt"  class="java.lang.String"/>
    <parameter name="generatedBy"  class="java.lang.String"/>

    <!-- Demo columns — replace with the real register's fields. -->
    <field name="code"        class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="amountText"  class="java.lang.String"/>

    <title>
        <band height="76" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="5" backcolor="#9A2D2A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <image onErrorType="Blank">
                <reportElement x="0" y="14" width="60" height="40">
                    <printWhenExpression><![CDATA[$P{logoPath} != null && !$P{logoPath}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logoPath}]]></imageExpression>
            </image>

            <textField>
                <reportElement x="60" y="14" width="335" height="20" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="60" y="36" width="335" height="16" forecolor="#4A413A"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="395" y="14" width="160" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{generatedAt}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="395" y="26" width="160" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{periodLabel}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="60" width="555" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="150" height="20" forecolor="#1A1714"/>
                <box bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="0" width="285" height="20" forecolor="#1A1714"/>
                <box bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="120" height="20" forecolor="#1A1714"/>
                <box bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement textAlignment="Right" verticalAlignment="Bottom"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Amount (Rs)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="150" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{code}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="0" width="285" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="435" y="0" width="120" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{amountText}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#E5DDD0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="400" height="14" forecolor="#4A413A"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by FS-HRMS on " + $P{generatedAt}
                    + ($P{generatedBy} == null || $P{generatedBy}.isEmpty() ? "" : " by " + $P{generatedBy})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="6" width="75" height="14" forecolor="#4A413A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="475" y="6" width="80" height="14" forecolor="#4A413A"/>
                <textElement textAlignment="Left">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="22" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="4" width="435" height="16" forecolor="#1A1714"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="4" width="120" height="16" forecolor="#1A1714"/>
                <box rightPadding="4"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT} + " row(s)"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
