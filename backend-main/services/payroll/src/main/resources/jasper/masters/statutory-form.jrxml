<?xml version="1.0" encoding="UTF-8"?>
<!--
  MASTER TEMPLATE — Statutory form (category 2).

  Copy this file to start a new government-facing return (EOBI, PESSI,
  income-tax-deducted, or any future statutory filing). The mandated
  government layout/fields ALWAYS win over house style — only the
  letterhead (company name/logo + thin accent rule) is brand-colored;
  everything below it is black text on white with full black grid
  borders, exactly like the paper/portal form it mirrors. No zebra
  striping, no colored fills, no teal callouts in the body — those are
  brand flourishes and have no place on a document a regulator reads.

  Brand identity: only #9A2D2A appears, only in the letterhead accent
  rule. Body is #1A1714 on #FFFFFF, borders are solid black
  (0.5-0.75pt) — deliberately NOT the soft #E5DDD0 house border color,
  because a statutory form's grid needs to read as an official table
  even photocopied in pure black & white.

  Font: SansSerif (JVM logical font, no font-extension dependency).

  Parameters are the only place company name / logo / generation
  date+user are supplied — never hardcode them in a real report.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="master-statutory-form" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="9c5c3d36-1234-4abc-8000-0000000000f2">

    <parameter name="companyName"  class="java.lang.String"/>
    <parameter name="logoPath"     class="java.lang.String"/>
    <parameter name="formTitle"    class="java.lang.String"/>
    <parameter name="periodLabel"  class="java.lang.String"/>
    <parameter name="generatedAt"  class="java.lang.String"/>
    <parameter name="generatedBy"  class="java.lang.String"/>

    <!-- Demo columns — replace with the mandated form's exact fields. -->
    <field name="serial"       class="java.lang.Integer"/>
    <field name="employeeCode" class="java.lang.String"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="amountText"   class="java.lang.String"/>

    <title>
        <band height="66" splitType="Stretch">
            <image onErrorType="Blank">
                <reportElement x="0" y="6" width="50" height="34">
                    <printWhenExpression><![CDATA[$P{logoPath} != null && !$P{logoPath}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logoPath}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="50" y="2" width="702" height="20" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{formTitle} + " — " + $P{periodLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="24" width="702" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="46" width="802" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="50" width="802" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated " + $P{generatedAt}
                    + ($P{generatedBy} == null || $P{generatedBy}.isEmpty() ? "" : " by " + $P{generatedBy})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20" forecolor="#1A1714"/>
                <box><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[S.No]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="150" height="20" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Employee Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="452" height="20" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Employee Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="652" y="0" width="150" height="20" forecolor="#1A1714"/>
                <box rightPadding="6"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Amount (Rs)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="50" height="18" forecolor="#1A1714"/>
                <box><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{serial}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="150" height="18" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{employeeCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="452" height="18" forecolor="#1A1714"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{employeeName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="652" y="0" width="150" height="18" forecolor="#1A1714"/>
                <box rightPadding="6"><pen lineWidth="0.5" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{amountText}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="802" height="1" forecolor="#E5DDD0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="650" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated by FS-HRMS on " + $P{generatedAt}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="650" y="6" width="112" height="14" forecolor="#4A413A"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="762" y="6" width="40" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="652" height="20" forecolor="#1A1714"/>
                <box><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField>
                <reportElement x="652" y="0" width="150" height="20" forecolor="#1A1714"/>
                <box rightPadding="6"><pen lineWidth="0.75" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT} + " row(s)"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
