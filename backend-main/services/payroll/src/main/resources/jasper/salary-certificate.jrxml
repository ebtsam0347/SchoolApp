<?xml version="1.0" encoding="UTF-8"?>
<!--
  Salary certificate — the letter banks / embassies ask for.

  Layout: centred letterhead with maroon rule, Ref (left) and Date (right),
  underlined title, addressee, certification paragraph; then the salary
  table (one detail row per line: Basic, each fixed allowance) with a
  shaded Gross row, the gross in words, the salary account line, the
  "issued at the request of" closing and two signatures (Accounts, HR).

  Data contract: SalaryCertificateService. Rows carry label / amount
  (pre-formatted "Rs 65,292.00"); everything else is a parameter.
  Same print identity as the HR letters: ink #1A1714, accent #9A2D2A,
  labels #4A413A, chip #F8F4ED, rules #E5DDD0. Inline SansSerif with explicit
  pdfFontName for bold; never size 13.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="salary-certificate" pageWidth="595" pageHeight="842"
              columnWidth="495" leftMargin="50" rightMargin="50" topMargin="30" bottomMargin="30"
              uuid="9c5c3d36-1234-4abc-8000-000000000080">

    <parameter name="companyName"    class="java.lang.String"/>
    <parameter name="companyAddress" class="java.lang.String"/>
    <parameter name="companyContact" class="java.lang.String"/>
    <parameter name="refNo"          class="java.lang.String"/>
    <parameter name="letterDate"     class="java.lang.String"/>
    <parameter name="addressee"      class="java.lang.String"/>
    <parameter name="body"           class="java.lang.String"/>
    <parameter name="grossSalary"    class="java.lang.String"/>
    <parameter name="grossInWords"   class="java.lang.String"/>
    <parameter name="bankLine"       class="java.lang.String"/>
    <parameter name="closing"        class="java.lang.String"/>
    <parameter name="employeeCode"   class="java.lang.String"/>
    <parameter name="generatedAt"    class="java.lang.String"/>
    <parameter name="generatedBy"    class="java.lang.String"/>

    <field name="label"  class="java.lang.String"/>
    <field name="amount" class="java.lang.String"/>

    <title>
        <band height="176" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="495" height="20" forecolor="#1A1714"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="14" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="21" width="495" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{companyAddress}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="33" width="495" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{companyContact}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="50" width="495" height="1" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="60" width="300" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA["Ref: " + $P{refNo}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="300" y="60" width="195" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{letterDate}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="86" width="495" height="18" forecolor="#1A1714"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="12" isBold="true" pdfFontName="Helvetica-Bold" isUnderline="true"/></textElement>
                <text><![CDATA[SALARY CERTIFICATE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="116" width="495" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{addressee}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement positionType="Float" x="0" y="138" width="495" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Justified"><font fontName="SansSerif" size="10"/><paragraph lineSpacing="1_1_2"/></textElement>
                <textFieldExpression><![CDATA[$P{body}]]></textFieldExpression>
            </textField>
            <!-- Table header -->
            <staticText>
                <reportElement positionType="Float" x="60" y="158" width="235" height="18" forecolor="#1A1714"/>
                <box leftPadding="8" bottomPadding="3"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="9" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement positionType="Float" x="295" y="158" width="140" height="18" forecolor="#1A1714"/>
                <box rightPadding="8" bottomPadding="3"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement textAlignment="Right" verticalAlignment="Bottom"><font fontName="SansSerif" size="9" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[Amount per Month]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="18" splitType="Prevent">
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="0" width="235" height="18" forecolor="#1A1714"/>
                <box leftPadding="8"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{label}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="295" y="0" width="140" height="18" forecolor="#1A1714"/>
                <box rightPadding="8"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="26">
            <line>
                <reportElement x="0" y="0" width="495" height="1" forecolor="#E5DDD0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="5" width="400" height="10" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
                <textFieldExpression><![CDATA["System-generated by FS-HRMS on " + $P{generatedAt} + " by " + $P{generatedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="5" width="60" height="10" forecolor="#4A413A"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="460" y="5" width="35" height="10" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="15" width="495" height="10" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{employeeCode}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="230" splitType="Prevent">
            <!-- Gross row -->
            <staticText>
                <reportElement mode="Opaque" x="60" y="0" width="235" height="22" forecolor="#1A1714" backcolor="#F8F4ED"/>
                <box leftPadding="8"><topPen lineWidth="1.0" lineColor="#1A1714"/><bottomPen lineWidth="1.0" lineColor="#1A1714"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[Gross Monthly Salary]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement mode="Opaque" x="295" y="0" width="140" height="22" forecolor="#9A2D2A" backcolor="#F8F4ED"/>
                <box rightPadding="8"><topPen lineWidth="1.0" lineColor="#1A1714"/><bottomPen lineWidth="1.0" lineColor="#1A1714"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="11" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{grossSalary}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="60" y="26" width="375" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="9" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
                <textFieldExpression><![CDATA["(" + $P{grossInWords} + ")"]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement positionType="Float" x="0" y="52" width="495" height="14" forecolor="#1A1714">
                    <printWhenExpression><![CDATA[$P{bankLine} != null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Justified"><font fontName="SansSerif" size="10"/><paragraph lineSpacing="1_1_2"/></textElement>
                <textFieldExpression><![CDATA[$P{bankLine}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement positionType="Float" x="0" y="72" width="495" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Justified"><font fontName="SansSerif" size="10"/><paragraph lineSpacing="1_1_2"/></textElement>
                <textFieldExpression><![CDATA[$P{closing}]]></textFieldExpression>
            </textField>

            <!-- Signatures -->
            <textField isBlankWhenNull="true">
                <reportElement positionType="Float" x="0" y="104" width="260" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="10"/></textElement>
                <textFieldExpression><![CDATA["For " + $P{companyName}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="Float" x="0" y="170" width="180" height="1" forecolor="#1A1714"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="174" width="180" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[Accounts Manager]]></text>
            </staticText>
            <line>
                <reportElement positionType="Float" x="315" y="170" width="180" height="1" forecolor="#1A1714"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="315" y="174" width="180" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[General Manager HR]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
