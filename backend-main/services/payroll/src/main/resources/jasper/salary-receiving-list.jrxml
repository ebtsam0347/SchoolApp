<?xml version="1.0" encoding="UTF-8"?>
<!--
  Salary receiving list — the run-wide acknowledgement register, every
  payslip regardless of payment mode (bank-transfer-letter.jrxml and
  cash-payment-sheet.jrxml split those two modes into their own
  documents; this one is the single signed record for the whole run,
  the standard factory-floor audit trail: each employee signs against
  their own line to confirm receipt, whatever the disbursement channel).

  Letterhead follows masters/formal-letter.jrxml (logo top-left, company
  name/address top-right, thin #9A2D2A rule); the table follows
  masters/tabular-register.jrxml (bold black headers + vermillion bottom
  rule, cream/white zebra). Money values arrive as pre-formatted
  strings.

  Filled by DisbursementReportService.renderSalaryReceivingList.
-->
<jasperReport whenNoDataType="AllSectionsNoDetail" xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="salary-receiving-list" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="9c5c3d36-1234-4abc-8000-000000000032">

    <style name="row.zebra" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
            <style backcolor="#F8F4ED"/>
        </conditionalStyle>
    </style>

    <parameter name="companyName"      class="java.lang.String"/>
    <parameter name="companyAddress"   class="java.lang.String"/>
    <parameter name="logoPath"         class="java.lang.String"/>
    <parameter name="periodLabel"      class="java.lang.String"/>
    <parameter name="location"         class="java.lang.String"/>

    <parameter name="totalCount"       class="java.lang.Integer"/>
    <parameter name="totalAmountText"  class="java.lang.String"/>
    <parameter name="totalAmountWords" class="java.lang.String"/>

    <parameter name="preparedByName"        class="java.lang.String"/>
    <parameter name="preparedByDesignation" class="java.lang.String"/>
    <parameter name="verifiedByName"        class="java.lang.String"/>
    <parameter name="verifiedByDesignation" class="java.lang.String"/>
    <parameter name="generatedAt"      class="java.lang.String"/>
    <parameter name="generatedBy"      class="java.lang.String"/>

    <field name="serial"       class="java.lang.Integer"/>
    <field name="employeeCode" class="java.lang.String"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="department"   class="java.lang.String"/>
    <field name="paymentMode"  class="java.lang.String"/>
    <field name="amountText"   class="java.lang.String"/>

    <title>
        <band height="150" splitType="Stretch">
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="60" height="40">
                    <printWhenExpression><![CDATA[$P{logoPath} != null && !$P{logoPath}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logoPath}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="205" y="0" width="350" height="18" forecolor="#1A1714"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="205" y="19" width="350" height="20" forecolor="#4A413A"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{companyAddress}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="44" width="555" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

            <staticText>
                <reportElement x="0" y="56" width="555" height="16" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[SALARY RECEIVING LIST]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="78" width="555" height="14" forecolor="#1A1714"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Salary for the Month of " + $P{periodLabel}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="94" width="555" height="14" forecolor="#4A413A"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Location: " + $P{location}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="114" width="555" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{totalCount} + " employee(s) — sign against your name to acknowledge receipt of the amount shown:"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="25" height="20" forecolor="#1A1714"/>
                <box bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement textAlignment="Center" verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[S.No]]></text>
            </staticText>
            <staticText>
                <reportElement x="25" y="0" width="55" height="20" forecolor="#1A1714"/>
                <box leftPadding="4" bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Emp. Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="130" height="20" forecolor="#1A1714"/>
                <box leftPadding="4" bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Employee Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="90" height="20" forecolor="#1A1714"/>
                <box leftPadding="4" bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Department]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="60" height="20" forecolor="#1A1714"/>
                <box bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement textAlignment="Center" verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Mode]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="75" height="20" forecolor="#1A1714"/>
                <box rightPadding="6" bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement textAlignment="Right" verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Amount (Rs)]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="120" height="20" forecolor="#1A1714"/>
                <box bottomPadding="2"><bottomPen lineWidth="1.5" lineColor="#9A2D2A"/></box>
                <textElement textAlignment="Center" verticalAlignment="Bottom"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[Signature]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="25" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{serial}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="25" y="0" width="55" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{employeeCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="130" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{employeeName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="210" y="0" width="90" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{department}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="60" height="18" forecolor="#9A2D2A" style="row.zebra"/>
                <box><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{paymentMode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="0" width="75" height="18" forecolor="#1A1714" style="row.zebra"/>
                <box rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{amountText}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="435" y="0" width="120" height="18" style="row.zebra"/>
                <box><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <text><![CDATA[]]></text>
            </staticText>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#E5DDD0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="400" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated by FS-HRMS on " + $P{generatedAt}
                    + ($P{generatedBy} == null || $P{generatedBy}.isEmpty() ? "" : " by " + $P{generatedBy})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="6" width="75" height="14" forecolor="#4A413A"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="475" y="6" width="80" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="170" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="555" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="4" width="360" height="16" forecolor="#1A1714"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField>
                <reportElement x="360" y="4" width="75" height="16" forecolor="#1A1714"/>
                <box rightPadding="6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{totalAmountText}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="26" width="555" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Amount in words: " + $P{totalAmountWords}]]></textFieldExpression>
            </textField>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="48" width="555" height="26" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[
                    "Each signature above confirms receipt of the net salary shown for the month of "
                    + $P{periodLabel} + ", whether disbursed by bank transfer or cash."
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="86" width="250" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Prepared By"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="305" y="86" width="250" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Verified By"]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="110" width="180" height="1" forecolor="#1A1714"/>
            </line>
            <line>
                <reportElement x="305" y="110" width="180" height="1" forecolor="#1A1714"/>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="112" width="250" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{preparedByName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="124" width="250" height="10" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{preparedByDesignation}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="305" y="112" width="250" height="14" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{verifiedByName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="305" y="124" width="250" height="10" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{verifiedByDesignation}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
