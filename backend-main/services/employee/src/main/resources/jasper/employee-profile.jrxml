<?xml version="1.0" encoding="UTF-8"?>
<!--
  Employee Profile — one employee's personnel file.

  Data contract: EmployeeProfileReportService. Every row carries
  $F{section} (group key, in print order) and $F{kind}, which selects one
  of four detail bands:
    kv     two label/value pairs side by side   (l1, v1, l2, v2)
    wide   one label/value across the page      (l1, v1)
    table  five cells under the section headings (c1..c5, headings h1..h5)
    empty  "No records." for a table section with no rows
  Table rows repeat h1..h5 so the group header reads the headings off the
  first row of the section.

  Same fixed print identity as the other employee/payroll reports
  (see headcount-snapshot.jrxml): accent #9A2D2A on rules and section
  titles only, body #1A1714, labels #4A413A, zebra #F8F4ED, rules #E5DDD0.
  No filled headers; reads correctly in black & white. Fonts are inline
  SansSerif and avoid size 13 (drops text in this environment's PDF export).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="employee-profile" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="9c5c3d36-1234-4abc-8000-000000000040">

    <style name="row.zebra" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[new Boolean($V{sectionGroup_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
            <style backcolor="#F8F4ED"/>
        </conditionalStyle>
    </style>

    <parameter name="companyName"      class="java.lang.String"/>
    <parameter name="companyAddress"   class="java.lang.String"/>
    <parameter name="reportTitle"      class="java.lang.String"/>
    <parameter name="employeeName"     class="java.lang.String"/>
    <parameter name="employeeCode"     class="java.lang.String"/>
    <parameter name="designation"      class="java.lang.String"/>
    <parameter name="department"       class="java.lang.String"/>
    <parameter name="employmentStatus" class="java.lang.String"/>
    <parameter name="photo"            class="java.io.InputStream"/>
    <parameter name="generatedBy"      class="java.lang.String"/>
    <parameter name="generatedAt"      class="java.lang.String"/>

    <field name="section" class="java.lang.String"/>
    <field name="kind"    class="java.lang.String"/>
    <field name="l1" class="java.lang.String"/>
    <field name="v1" class="java.lang.String"/>
    <field name="l2" class="java.lang.String"/>
    <field name="v2" class="java.lang.String"/>
    <field name="h1" class="java.lang.String"/>
    <field name="h2" class="java.lang.String"/>
    <field name="h3" class="java.lang.String"/>
    <field name="h4" class="java.lang.String"/>
    <field name="h5" class="java.lang.String"/>
    <field name="c1" class="java.lang.String"/>
    <field name="c2" class="java.lang.String"/>
    <field name="c3" class="java.lang.String"/>
    <field name="c4" class="java.lang.String"/>
    <field name="c5" class="java.lang.String"/>

    <group name="sectionGroup" minHeightToStartNewPage="70">
        <groupExpression><![CDATA[$F{section}]]></groupExpression>
        <groupHeader>
            <band height="26" splitType="Prevent">
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="8" width="555" height="16" forecolor="#9A2D2A"/>
                    <box><bottomPen lineWidth="0.75" lineColor="#9A2D2A"/></box>
                    <textElement verticalAlignment="Bottom"><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{section}.toUpperCase()]]></textFieldExpression>
                </textField>
            </band>
            <band height="18" splitType="Prevent">
                <printWhenExpression><![CDATA["table".equals($F{kind})]]></printWhenExpression>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="2" width="131" height="16" forecolor="#1A1714"/>
                    <box leftPadding="3"><bottomPen lineWidth="0.75" lineColor="#E5DDD0"/></box>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{h1}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="131" y="2" width="111" height="16" forecolor="#1A1714"/>
                    <box leftPadding="3"><bottomPen lineWidth="0.75" lineColor="#E5DDD0"/></box>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{h2}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="242" y="2" width="111" height="16" forecolor="#1A1714"/>
                    <box leftPadding="3"><bottomPen lineWidth="0.75" lineColor="#E5DDD0"/></box>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{h3}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="353" y="2" width="101" height="16" forecolor="#1A1714"/>
                    <box leftPadding="3"><bottomPen lineWidth="0.75" lineColor="#E5DDD0"/></box>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{h4}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="454" y="2" width="101" height="16" forecolor="#1A1714"/>
                    <box leftPadding="3"><bottomPen lineWidth="0.75" lineColor="#E5DDD0"/></box>
                    <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                    <textFieldExpression><![CDATA[$F{h5}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="150" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="440" height="16" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="12" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="17" width="440" height="12" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{companyAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="36" width="440" height="20" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="14" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[($P{reportTitle} == null || $P{reportTitle}.isEmpty())
                    ? "Employee Profile" : $P{reportTitle}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="62" width="440" height="2" forecolor="#9A2D2A"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="72" width="440" height="20" forecolor="#1A1714"/>
                <textElement><font fontName="SansSerif" size="14" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{employeeName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="94" width="440" height="14" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="10"/></textElement>
                <textFieldExpression><![CDATA[
                    ($P{designation} == null ? "" : $P{designation})
                    + ($P{department} == null ? "" : ($P{designation} == null ? "" : "  ·  ") + $P{department})
                ]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="114" width="90" height="14" forecolor="#4A413A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[EMPLOYEE CODE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="114" width="120" height="14" forecolor="#1A1714"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{employeeCode}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="220" y="114" width="60" height="14" forecolor="#4A413A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="114" width="160" height="14" forecolor="#1A1714"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$P{employmentStatus}]]></textFieldExpression>
            </textField>

            <!-- Passport-size photo, or an outlined placeholder when none is on file. -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="463" y="0" width="92" height="112">
                    <printWhenExpression><![CDATA[$P{photo} != null]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.75" lineColor="#E5DDD0"/></box>
                <imageExpression><![CDATA[$P{photo}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="463" y="0" width="92" height="112" forecolor="#4A413A">
                    <printWhenExpression><![CDATA[$P{photo} == null]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.75" lineStyle="Dashed" lineColor="#E5DDD0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
                <text><![CDATA[No photo on file]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <!-- kv: two label/value pairs -->
        <band height="16" splitType="Prevent">
            <printWhenExpression><![CDATA["kv".equals($F{kind})]]></printWhenExpression>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="110" height="16" forecolor="#4A413A"/>
                <box leftPadding="3" topPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$F{l1}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="110" y="0" width="167" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{v1}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="283" y="0" width="110" height="16" forecolor="#4A413A"/>
                <box leftPadding="3" topPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$F{l2}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="393" y="0" width="162" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{v2}]]></textFieldExpression>
            </textField>
        </band>

        <!-- wide: one label/value across the page (addresses) -->
        <band height="16" splitType="Prevent">
            <printWhenExpression><![CDATA["wide".equals($F{kind})]]></printWhenExpression>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="110" height="16" forecolor="#4A413A"/>
                <box leftPadding="3" topPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
                <textFieldExpression><![CDATA[$F{l1}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="110" y="0" width="445" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{v1}]]></textFieldExpression>
            </textField>
        </band>

        <!-- table: five cells under the section headings -->
        <band height="16" splitType="Prevent">
            <printWhenExpression><![CDATA["table".equals($F{kind})]]></printWhenExpression>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="row.zebra" stretchType="RelativeToTallestObject" x="0" y="0" width="131" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{c1}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="row.zebra" stretchType="RelativeToTallestObject" x="131" y="0" width="111" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{c2}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="row.zebra" stretchType="RelativeToTallestObject" x="242" y="0" width="111" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{c3}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="row.zebra" stretchType="RelativeToTallestObject" x="353" y="0" width="101" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{c4}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="row.zebra" stretchType="RelativeToTallestObject" x="454" y="0" width="101" height="16" forecolor="#1A1714"/>
                <box leftPadding="3" topPadding="2" rightPadding="3"><bottomPen lineWidth="0.5" lineColor="#E5DDD0"/></box>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{c5}]]></textFieldExpression>
            </textField>
        </band>

        <!-- empty: table section with no rows -->
        <band height="16" splitType="Prevent">
            <printWhenExpression><![CDATA["empty".equals($F{kind})]]></printWhenExpression>
            <staticText>
                <reportElement x="0" y="0" width="555" height="16" forecolor="#4A413A"/>
                <box leftPadding="3" topPadding="2"/>
                <textElement><font fontName="SansSerif" size="8" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
                <text><![CDATA[No records.]]></text>
            </staticText>
        </band>
    </detail>

    <pageFooter>
        <band height="28">
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#E5DDD0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="380" height="12" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
                <textFieldExpression><![CDATA[
                    ($P{employeeCode} == null ? "" : $P{employeeCode} + "   ")
                    + (($P{generatedBy} == null || $P{generatedBy}.isEmpty()) ? "" : "Generated by: " + $P{generatedBy} + "   ")
                    + (($P{generatedAt} == null || $P{generatedAt}.isEmpty()) ? "" : "Generated at: " + $P{generatedAt})
                ]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="6" width="90" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="470" y="6" width="85" height="12" forecolor="#4A413A"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="18" width="555" height="10" forecolor="#4A413A"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="7" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
                <text><![CDATA[Confidential — Personnel record. For authorized HR use only.]]></text>
            </staticText>
        </band>
    </pageFooter>

    <summary>
        <band height="80" splitType="Prevent">
            <line>
                <reportElement x="0" y="56" width="180" height="1" forecolor="#1A1714"/>
            </line>
            <staticText>
                <reportElement x="0" y="60" width="180" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Employee Signature]]></text>
            </staticText>
            <line>
                <reportElement x="375" y="56" width="180" height="1" forecolor="#1A1714"/>
            </line>
            <staticText>
                <reportElement x="375" y="60" width="180" height="12" forecolor="#4A413A"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[HR Department]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
